{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit(server/**)",
      "Edit(client/src/**)",
      "Edit(shared/**)",
      "Edit(tests/**)",
      "Edit(evidence/**)",
      "Edit(sprints.json)",
      "Edit(plan.md)",
      "Edit(issues.md)",
      "Edit(acceptance_criteria.md)",
      "Edit(agent-instructions.json)",
      "Write(server/**)",
      "Write(client/src/**)",
      "Write(shared/**)",
      "Write(tests/**)",
      "Write(evidence/**)",
      "Bash(npx tsc *)",
      "Bash(npx playwright *)",
      "Bash(npm run build)",
      "Bash(npm run dev *)",
      "Bash(npm test *)",
      "Bash(node *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git branch *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(test *)",
      "Bash(echo *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(python3 *)",
      "Bash(psql *)",
      "Bash(md5sum *)",
      "Bash(stat *)",
      "Bash(date *)",
      "Bash(bash scripts/watchdog.sh *)",
      "Bash(bash scripts/enforcer-checklist.sh *)",
      "Bash(bash scripts/check-file-scope.sh *)",
      "Bash(pm2 logs *)",
      "Bash(pm2 list *)",
      "Bash(pm2 status *)",
      "Bash(curl *)"
    ],
    "deny": [
      "Edit(CLAUDE.md)",
      "Edit(harness.md)",
      "Edit(scripts/pre-commit.sh)",
      "Edit(scripts/watchdog.sh)",
      "Edit(.claude/**)",
      "Edit(.ghost/**)",
      "Write(CLAUDE.md)",
      "Write(harness.md)",
      "Write(scripts/pre-commit.sh)",
      "Write(scripts/watchdog.sh)",
      "Write(.claude/**)",
      "Write(.ghost/**)",
      "Bash(rm -rf *)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git checkout -- *)",
      "Bash(pm2 delete *)",
      "Bash(pm2 stop *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/context-check.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest", "--headless"]
    },
    "nexxus-integrations": {
      "url": "http://0.0.0.0:4002/mcp",
      "headers": {
        "Authorization": "Bearer 8NCVZ8ZCgHtab6A+FxHsgOKcgir89KvOR+wMIpYFLp4="
      }
    }
  }
}

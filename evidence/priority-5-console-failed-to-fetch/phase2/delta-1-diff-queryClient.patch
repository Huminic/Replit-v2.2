+// Predicate for navigation/abort errors that should not be logged as
+// "Query error". TanStack v5 already silently skips its own CancelledError
+// from onError (query-core/build/modern/query.js:215-220), but a fetch that
+// was aborted by other means (browser-driven cancellation when the observer
+// unmounts mid-flight, third-party code that doesn't honor the signal,
+// pagehide/unload races) surfaces as a native TypeError("Failed to fetch")
+// or DOMException("AbortError"), which TanStack does NOT treat as cancelled.
+// This filter is intentionally narrow — it must not swallow real backend
+// failures.
+//   - error.name === "AbortError"           → DOMException from AbortController
+//   - message === "Failed to fetch"         → exact native TypeError text
+//   - /aborted/i.test(message)              → "The user aborted a request",
+//                                             "The operation was aborted"
+// Real backend errors from throwIfResNotOk are formatted as `${status}: ${body}`
+// which always begins with a digit and never matches any of the predicates.
+function isNavigationAbortError(error: unknown): boolean {
+  if (!(error instanceof Error)) return false;
+  if (error.name === "AbortError") return true;
+  const msg = error.message ?? "";
+  if (msg === "Failed to fetch") return true;
+  if (/\baborted\b/i.test(msg)) return true;
+  return false;
+}

# Nexxus Connect v2.2 — Environment Variables
# Copy to .env and fill in values

# ═══════════════════════════════════════════════
# REQUIRED
# ═══════════════════════════════════════════════

# PostgreSQL connection string (Neon or Supabase)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# JWT signing secret (min 32 chars)
JWT_SECRET=your-jwt-secret-here

# Application base URL (used for CORS, email links, widget URLs)
APP_BASE_URL=https://your-domain.com

# ═══════════════════════════════════════════════
# AUTHENTICATION (production only)
# ═══════════════════════════════════════════════

# Production admin credentials (required when NODE_ENV=production and DB is empty)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=secure-password-here

# Override default seed password for dev accounts
# SEED_DEFAULT_PASSWORD=
# HUMINIC_ADMIN_PASSWORD=

# ═══════════════════════════════════════════════
# AI / LLM
# ═══════════════════════════════════════════════

# Anthropic API (required for chat features)
AI_INTEGRATIONS_ANTHROPIC_API_KEY=sk-ant-...
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI (optional — image generation)
# OPENAI_API_KEY=

# ═══════════════════════════════════════════════
# COMMUNICATIONS
# ═══════════════════════════════════════════════

# Resend (email sending)
# RESEND_API_KEY=

# TextMagic (SMS)
# TEXTMAGIC_API_KEY=
# TEXTMAGIC_USERNAME=
# TEXTMAGIC_WEBHOOK_SECRET=
# DEFAULT_TEXTMAGIC_PHONE=18338096836

# Enable live outbound messaging (default: disabled)
# OUTBOUND_LIVE_ENABLED=true

# ═══════════════════════════════════════════════
# VOICE / VIDEO
# ═══════════════════════════════════════════════

# VAPI (voice AI)
# VAPI_PRIVATE_KEY=

# Tavus (video AI)
# TAVUS_API_KEY=
# TAVUS_WEBHOOK_SECRET=

# ═══════════════════════════════════════════════
# INTEGRATIONS
# ═══════════════════════════════════════════════

# VinSolutions MCP
# MCP_BASE_URL=https://mcp.huminicdev.com
# VINSOLUTIONS_MCP_URL=
# VINSOLUTIONS_API_KEY=
# NEXXUS_ORG_MAP={"serra-honda":"org-id-here"}

# Billing (FlexPrice)
# FLEXPRICE_API_KEY=
# FLEXPRICE_BASE_URL=https://api.cloud.flexprice.io/v1
# BILLING_CUSTOMER_MAP={"serra-honda":"cust_id"}

# Brave Search
# BRAVE_SEARCH_API_KEY=

# FAL (AI image/video generation)
# FAL_KEY=

# Google Maps
# GOOGLE_MAPS_API_KEY=

# ═══════════════════════════════════════════════
# SERVER
# ═══════════════════════════════════════════════

# Server port (default: 5000)
PORT=5000

# Node environment
NODE_ENV=production

# Additional CORS origins (comma-separated)
# CORS_ORIGINS=https://extra-domain.com,https://another.com

# Database pool configuration
# DB_POOL_SIZE=10
# DB_IDLE_TIMEOUT=30000
# DB_CONNECTION_TIMEOUT=5000
